
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inpav-demandas-engenharia",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
