
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inpav-demandas-engenharia",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "engenharia-inpav-db",
      "database_id": "9080bcd9-aaf3-4534-a1a1-13582479d40a"
    }
  ],
  "observability": {
    "enabled": true
  }
}

{
  // ...
  "vars": {},
  // ...
}
